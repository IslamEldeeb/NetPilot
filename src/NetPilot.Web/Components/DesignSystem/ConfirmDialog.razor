<Sheet Open="Open" OpenChanged="OpenChanged" Title="@Title" Presentation="confirm-dialog">
    <ChildContent><p>@Body</p></ChildContent>
    <Footer>
        <Button Variant="outline" OnClick="CancelAsync" data-cancel="true">Cancel</Button>
        <Button Variant="@(Danger ? "danger" : "filled")" OnClick="AcceptAsync">@ConfirmText</Button>
    </Footer>
</Sheet>
@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm change";
    [Parameter] public string Body { get; set; } = "";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public EventCallback Confirmed { get; set; }
    private Task CancelAsync() => OpenChanged.InvokeAsync(false);
    private async Task AcceptAsync() { await OpenChanged.InvokeAsync(false); await Confirmed.InvokeAsync(); }
}
