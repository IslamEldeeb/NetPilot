<MudMenu Icon="@Icons.Material.Outlined.Brightness6" aria-label="Color theme" title="Color theme">
    @foreach (var preference in new[] { "system", "light", "dark" })
    {
        <MudMenuItem OnClick="@(() => PreferenceChanged.InvokeAsync(preference))"
                     Icon="@(Preference == preference ? Icons.Material.Filled.Check : null)">
            @(char.ToUpperInvariant(preference[0]) + preference[1..])
        </MudMenuItem>
    }
</MudMenu>
@code {
    [Parameter] public string Preference { get; set; } = "system";
    [Parameter] public EventCallback<string> PreferenceChanged { get; set; }
}
