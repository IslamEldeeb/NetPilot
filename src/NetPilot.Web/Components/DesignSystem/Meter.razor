<div class="np-meter" role="progressbar" aria-label="@Label" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-valuetext="@ValueText">
    <span style="@($"--fill:{Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></span>
</div>
@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public double Value { get; set; }
    [Parameter] public double Maximum { get; set; } = 100;
    [Parameter] public string? ValueText { get; set; }
    private double Percent => Maximum > 0 && double.IsFinite(Value / Maximum) ? Math.Clamp(Value / Maximum * 100, 0, 100) : 0;
}
