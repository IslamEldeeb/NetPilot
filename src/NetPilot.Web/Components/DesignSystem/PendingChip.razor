@using NetPilot.Core.Health
<span role="status"><StatusPill Kind="@Kind">@(State == ApplyState.AgentDown ? "Agent unavailable" : State.ToString())</StatusPill></span>
@code {
    [Parameter] public ApplyState State { get; set; } = ApplyState.Saved;
    private string Kind => State switch { ApplyState.Applied => "ok", ApplyState.AgentDown => "warning", _ => "info" };
}
