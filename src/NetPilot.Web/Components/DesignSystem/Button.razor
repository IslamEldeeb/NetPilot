<button type="@Type" class="np-button np-button-@Variant @Class" disabled="@(Disabled || Busy)" aria-busy="@Busy.ToString().ToLowerInvariant()" @onclick="OnClick" @attributes="Attributes">
    @if (Busy) { <span class="np-spinner" aria-hidden="true"></span><span>@BusyText</span> }
    else { @if (Icon is not null) { <Icon Name="@Icon" /> } @ChildContent }
</button>

@code {
    [Parameter] public string Variant { get; set; } = "filled";
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string BusyText { get; set; } = "Saving…";
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }
}
