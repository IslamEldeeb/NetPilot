<div class="np-ring" role="progressbar" aria-label="@Label" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-valuetext="@ValueText">
    <svg viewBox="0 0 120 120" aria-hidden="true"><circle class="np-ring-track" cx="60" cy="60" r="49" pathLength="100"/><circle class="np-ring-value" cx="60" cy="60" r="49" pathLength="100" style="@($"--ring-fill:{Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)}")"/></svg>
    <span class="np-ring-label">@ValueText</span>
</div>
@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public double Value { get; set; }
    [Parameter] public double Maximum { get; set; } = 100;
    [Parameter] public string? ValueText { get; set; }
    private double Percent => Maximum > 0 && double.IsFinite(Value / Maximum) ? Math.Clamp(Value / Maximum * 100, 0, 100) : 0;
}
