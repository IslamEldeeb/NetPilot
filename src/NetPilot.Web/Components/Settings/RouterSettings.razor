@using NetPilot.Abstractions
@using NetPilot.Core.RouterConnection
@using NetPilot.Core.Settings
@using NetPilot.Core.Usage
@inject IRouterConnectionStore Connections
@inject IRouterProvider Provider
@inject SettingsRouterActions Actions
@inject UsagePeriodClock Clock
<MudStack Spacing="3">
    <MudText Typo="Typo.h2">Router connection</MudText>
    <MudText>@Provider.DisplayName · @(_saved is null ? "Not configured" : "Configured (does not prove connected)")</MudText>
    <MudText Typo="Typo.caption">User: @(_saved?.Username ?? "admin"). Testing contacts the router directly and may contend with the Agent session. Router HTTPS is separate from dashboard HTTPS.</MudText>
    @if (_message is not null) { <MudAlert Severity="@(_failed ? Severity.Error : Severity.Info)" role="status">@_message</MudAlert> }
    <MudTextField T="string" Label="Router host or IP" @bind-Value="_host" Disabled="_busy" />
    <MudSwitch T="bool" Label="Use HTTPS to router" @bind-Value="_https" Disabled="_busy" />
    <MudTextField T="string" Label="New router password" InputType="InputType.Password" @bind-Value="_password" HelperText="Leave blank to keep the saved password. Saved secrets are never shown." autocomplete="new-password" Disabled="_busy" />
    <MudStack Row="true" Wrap="Wrap.Wrap">
        <MudButton OnClick="SaveAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy">Save connection</MudButton>
        <MudButton OnClick="TestAsync" Variant="Variant.Outlined" Disabled="_busy">@(_busy ? "Working…" : "Test connection")</MudButton>
        <MudButton OnClick="LoadAsync" Disabled="_busy">Cancel edits / Reload</MudButton>
    </MudStack>
</MudStack>
@code {
    [Parameter] public EventCallback Saved { get; set; }
    private RouterConnection? _saved;
    private string _host = "192.168.1.1", _password = "";
    private bool _https, _busy, _failed;
    private string? _message;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _failed = false; _message = null;
        try
        {
            _saved = await Connections.GetAsync(CancellationToken.None);
            _host = _saved?.Host ?? "192.168.1.1"; _https = _saved?.UseHttps ?? false; _password = "";
        }
        catch (Exception) { _failed = true; _message = "Could not load the saved connection. Retry using Reload."; }
    }
    private Task SaveAsync() => RunAsync(async () =>
    {
        await Actions.SaveAsync(_host, _https, _password);
        await LoadAsync();
        _message = "Connection saved encrypted. The Agent will read it on its next tick.";
        await Saved.InvokeAsync();
    });
    private Task TestAsync() => RunAsync(async () =>
    {
        var info = await Actions.TestAsync(_host, _https, _password);
        _message = $"Test succeeded at {TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), Clock.TimeZone):g}: {info.Model}; firmware {info.FirmwareVersion}. This does not verify traffic counters.";
    });
    private async Task RunAsync(Func<Task> operation)
    {
        if (_busy) return;
        _busy = true; _failed = false; _message = null;
        try { await operation(); }
        catch (SettingsValidationException ex) { _failed = true; _message = ex.Message; }
        catch (Exception) { _failed = true; _message = "Router request failed. Check host, transport and credentials, then retry. No secret is displayed."; }
        finally { _password = ""; _busy = false; }
    }
}
