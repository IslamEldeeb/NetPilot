@using NetPilot.Core.Health
@using NetPilot.Core.RouterConnection
@using NetPilot.Core.Usage
@inject IAgentHeartbeatStore Heartbeats
@inject IRouterConnectionStore Connections
@inject ILocalTrafficStore LocalTraffic
@inject UsagePeriodClock Clock

<div class="health-summary">
    <div class="row between"><div><h2>Network status</h2><p class="hint">Based on the Agent's last saved check. Refreshing this page does not contact the router.</p></div><button class="outline" @onclick="LoadAsync" disabled="@_loading">@(_loading ? "Refreshing…" : "Refresh status")</button></div>
    @if (_error is not null) { <div class="banner error" role="alert">@_error</div> }
    else if (_loaded)
    {
        <div class="health-grid">
            <div class="health-item"><span>Router</span><strong>@RouterStatus</strong><small>Last successful connection: @Local(_heartbeat?.LastSuccessfulRouterReadUtc)</small></div>
            <div class="health-item"><span>Agent</span><strong>@AgentStatus</strong><small>Last completed check: @Local(_heartbeat?.LastTickCompletedUtc)</small></div>
        </div>
        @if (!_configured) { <div class="banner info">No router configured. <a href="/settings/router">Set up connection</a></div> }
        else if (_heartbeat?.ConsecutiveFailedTicks > 0 || _heartbeat?.LastErrorSummary is not null)
        { <div class="banner error" role="alert">The last Agent check failed. @_heartbeat?.LastErrorSummary Check the router connection and try the connection test. <a href="/settings/router">Router settings</a></div> }
        else if (Operational is AgentHealthStatus.Stale or AgentHealthStatus.Down)
        { <div class="banner info">The latest router data is out of date. Check that the Agent and router are running.</div> }
        @if (_traffic.IsConfigured && _traffic.UnavailableSinceUtc is not null)
        { <div class="banner info">LAN traffic data is unavailable. Usage may include local network traffic.</div> }
        else if (!_traffic.IsConfigured)
        { <p class="hint">LAN traffic exclusion is not configured, so usage may include local network traffic.</p> }
        <p class="hint">Last successful connection is a saved observation, not a live connection test. Times shown in @Clock.TimeZone.Id.</p>
        <a href="/settings/router" class="text-button">Test router connection</a>
    }
</div>
@code {
    private AgentHeartbeat? _heartbeat;
    private LocalTrafficStatus _traffic = new();
    private bool _configured, _loading, _loaded;
    private string? _error;
    private AgentHealthStatus Operational => AgentHealth.EvaluateOperational(_heartbeat, Clock.GetUtcNow());
    private string AgentStatus => AgentHealth.Evaluate(_heartbeat, Clock.GetUtcNow()) switch
    { AgentHealthStatus.Healthy => "Running", AgentHealthStatus.Stale => "Delayed", AgentHealthStatus.Down => "Not responding", _ => "Unknown" };
    private string RouterStatus => !_configured ? "Not configured" : Operational switch
    { AgentHealthStatus.Healthy => "Last check succeeded", AgentHealthStatus.Stale => "Check delayed", AgentHealthStatus.Down => "Needs attention", _ => "Unknown" };
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        if (_loading) return;
        _loading = true; _error = null;
        try
        {
            _heartbeat = await Heartbeats.GetAsync(CancellationToken.None);
            _configured = await Connections.GetAsync(CancellationToken.None) is not null;
            _traffic = await LocalTraffic.GetStatusAsync(CancellationToken.None);
            _loaded = true;
        }
        catch (Exception) { _error = "Could not load saved health status. Please retry."; }
        finally { _loading = false; }
    }
    private string Local(DateTimeOffset? at) => at is null ? "Not available" : TimeZoneInfo.ConvertTime(at.Value, Clock.TimeZone).ToString("g");
}
