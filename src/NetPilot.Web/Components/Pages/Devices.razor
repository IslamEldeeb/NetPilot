@page "/devices"
@layout AppShell
@using NetPilot.Core.Devices
@using NetPilot.Core.Quota
@using NetPilot.Core.Usage
@using NetPilot.Web.Components.Devices
@using NetPilot.Web.Components.DesignSystem
<PageTitle>Devices · NetPilot</PageTitle>
<div class="page-head">
    <div>
        <div class="eyebrow">Your network</div>
        <h1>Devices</h1>
        <p>@CountText</p>
    </div>
    <div class="actions">
        <button class="outline" @onclick="RefreshFromRouterAsync" disabled="@(_connection is null || _refreshing || _bulkBusy)">@((MarkupString)Icon("refresh")) @(_refreshing ? "Refreshing…" : "Refresh from router")</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="banner error" role="alert">
        <span class="icon">@((MarkupString)Icon("warning"))</span>
        <div>
            <strong>Couldn’t load devices</strong>
            <p>@_error</p>
            <button class="outline" @onclick="LoadAsync">Retry saved data</button>
        </div>
    </div>
}
@if (_lastRefresh is { } refreshed)
{
    <p class="hint">Last manual refresh: @TimeZoneInfo.ConvertTime(refreshed, Clock.TimeZone).ToString("g") · @Clock.TimeZone.Id</p>
}

@if (!_loaded)
{
    <div class="skeleton-wrap" aria-busy="true">
        <div class="skeleton"></div>
        <div class="skeleton"></div>
    </div>
}
else if (_devices.Count == 0)
{
    <div class="card empty-state">
        <span class="symbol-tile">@((MarkupString)Icon("devices"))</span>
        <h2>No devices discovered yet</h2>
        <p>Connect a router, discover devices and start in dry-run.</p>
        <a href="/setup/1" class="button">Start setup</a>
    </div>
}
else
{
    @if (_connection is null)
    {
        <div class="banner info">
            <span class="icon">@((MarkupString)Icon("router"))</span>
            <p>No router connection is saved. Saved device data stays readable; router actions are unavailable.</p>
        </div>
    }
    <div class="toolbar">
        <label class="field search-field">Find a device
            <input id="device-search" type="search" value="@_search" @oninput="e => _search = e.Value?.ToString() ?? string.Empty" placeholder="Name, MAC or IP address" />
        </label>
        <label class="field">Category
            <select id="category-filter" @bind="_category">
                <option value="">All categories</option>
                @foreach (var category in Categories)
                {
                    <option value="@category">@category.Replace('_', ' ')</option>
                }
            </select>
        </label>
        <label class="field">Connection
            <select id="online-filter" @bind="_connectionFilter">
                <option value="all">All devices</option>
                <option value="online">Online only</option>
                <option value="offline">Offline only</option>
            </select>
        </label>
        <label class="field">Group by
            <select id="group-filter" @bind="_groupBy">
                <option value="category">Category</option>
                <option value="none">None</option>
                <option disabled>Person · needs backend</option>
            </select>
        </label>
    </div>

    <div class="np-device-filters" role="group" aria-label="Quick filters">
        <button type="button" class="np-filter-chip" aria-pressed="@(_connectionFilter == "all" && !_restrictedOnly && !_newOnly ? "true" : "false")" @onclick="@(() => SetQuickFilter("all"))">All</button>
        <button type="button" class="np-filter-chip" aria-pressed="@(_connectionFilter == "online" && !_restrictedOnly && !_newOnly ? "true" : "false")" @onclick="@(() => SetQuickFilter("online"))">Online</button>
        <button type="button" class="np-filter-chip" aria-pressed="@(_restrictedOnly ? "true" : "false")" @onclick="@(() => SetQuickFilter("limited"))">Limited</button>
        <button type="button" class="np-filter-chip" aria-pressed="@(_newOnly ? "true" : "false")" @onclick="@(() => SetQuickFilter("new"))">New</button>
    </div>

    @if (_selected.Count > 0)
    {
        <div class="selection-bar">
            <strong>@_selected.Count selected</strong>
            <div class="actions">
                <button class="tonal" @onclick="@(() => _bulkPause = true)">@((MarkupString)Icon("pause")) Pause selected</button>
                <button class="outline" @onclick="@(() => BulkSetBlockAsync(true))" disabled="@(_bulkBusy || _connection is null)">Block selected</button>
                <button class="outline" @onclick="@(() => BulkSetBlockAsync(false))" disabled="@(_bulkBusy || _connection is null)">Unblock selected</button>
                <button class="text-button" @onclick="@(() => _selected.Clear())">Clear</button>
            </div>
        </div>
    }

    @if (VisibleRows.Count == 0)
    {
        <div class="card empty-state">
            <span class="symbol-tile">@((MarkupString)Icon("devices"))</span>
            <h2>No matching devices</h2>
            <p>Try a name, MAC address or a different filter.</p>
            <button class="button" @onclick="ClearFilters">Clear filters</button>
        </div>
    }
    else
    {
        <div class="np-device-grid">
            @foreach (var row in VisibleRows)
            {
                <article class="card np-device-card @(row.IsBlocked ? "is-blocked" : "")">
                    <div class="np-device-card-head">
                        <span class="symbol-tile np-device-icon">
                            @((MarkupString)Icon(IconFor(row)))
                            <span class="np-device-presence @(row.Device.Connection.IsOnline ? "online" : "")" aria-hidden="true"></span>
                        </span>
                        <div class="np-device-heading">
                            <a href="@($"/devices/{row.Device.Mac}")">@row.DisplayName</a>
                            <small>@row.Device.CategoryKey.Replace('_', ' ') · @(row.Device.Connection.IsOnline ? DeviceList.DescribeMedium(row.Device.Connection.Medium) : "Offline")</small>
                        </div>
                        <label class="select-box">
                            <input type="checkbox" checked="@_selected.Contains((string)row.Device.Mac)"
                                   @onchange="e => ToggleSelect(row.Device.Mac, e.Value is true)"
                                   aria-label="@($"Select {row.DisplayName}")" />
                        </label>
                    </div>
                    <div class="np-device-card-status">@RestrictionChip(row)</div>
                    <div class="np-device-addresses"><span><b>IP</b> <bdi>@row.Device.IpAddress</bdi></span><span><b>MAC</b> <bdi>@row.Device.Mac</bdi></span></div>
                    <div class="np-speed-panel @(HasLimitMismatch(row.Device) ? "np-speed-mismatch" : "")">
                        <div class="np-speed-heading">
                            <span>Speed limit</span>
                            <button type="button" class="np-speed-edit" @onclick="@(() => EditSpeed(row.Device))" aria-expanded="@(_speedMac == (string)row.Device.Mac ? "true" : "false")" aria-label="@($"Edit speed for {row.DisplayName}")">Edit</button>
                        </div>
                        <div class="np-speed-values"><span>Saved <strong>@LimitText(row.Device)</strong></span><span>Router <strong>@RouterLimitText(row.Device)</strong></span></div>
                        @if (HasLimitMismatch(row.Device))
                        {
                            <details class="np-speed-discrepancy"><summary>Different from saved limit</summary><small>Temporary restrictions can also change the router limit.</small></details>
                        }
                        @if (_speedMac == (string)row.Device.Mac)
                        {
                            <div class="np-speed-editor">
                                <label class="field">Download Mbps <input type="number" min="0.001" step="0.001" @bind="_speedDown" /></label>
                                <label class="field">Upload Mbps <input type="number" min="0.001" step="0.001" @bind="_speedUp" /></label>
                                <p class="hint">Leave a field empty for unlimited. Saving applies a device override on the next Agent tick.</p>
                                <div class="actions"><button class="button" @onclick="SaveSpeed" disabled="@_speedBusy">Save</button><button class="outline" @onclick="ClearSpeed" disabled="@_speedBusy">Use category</button><button class="text-button" @onclick="@(() => _speedMac = null)">Cancel</button></div>
                            </div>
                        }
                    </div>
                    <div class="np-device-usage"><span>Today</span><span><strong>@DataSize.ToGb(row.InternetTodayBytes).ToString("0.##")</strong> GB</span></div>
                    @if (row.QuotaDailyBytes is > 0)
                    {
                        <div class="np-device-quota">
                            <div class="np-device-quota-label"><span>Daily allowance</span><span>@DataSize.ToGb(row.InternetTodayBytes).ToString("0.##") / @DataSize.ToGb(row.QuotaDailyBytes.Value).ToString("0.##") GB</span></div>
                            <div class="np-device-meter" role="progressbar" aria-label="Daily allowance used" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Round(row.QuotaPercent)"><span style="width:@(row.QuotaPercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                        </div>
                    }
                    else { <small class="np-device-no-quota">No daily cap</small> }
                </article>
            }
        </div>
    }
}

<AppSheet @bind-Open="_bulkPause" Title="Pause selected devices">
    <MudStack Spacing="3">
        <MudText>Pause and bonus-data controls save expiring claims for the Agent’s next tick. Protected targets are skipped.</MudText>
        <MudButton OnClick="@(() => _bulkPause = false)" Variant="Variant.Filled" Color="Color.Primary">Close</MudButton>
    </MudStack>
</AppSheet>

@code {
    private string Icon(string name) => name switch
    {
        "refresh" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 7v5h-5M4 17v-5h5M5 7a8 8 0 0 1 14-1M5 18a8 8 0 0 0 14-1\"/></svg>",
        "warning" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 3 10 18H2Z\"/><path d=\"M12 9v5m0 3h.1\"/></svg>",
        "router" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"12\" width=\"18\" height=\"8\" rx=\"2\"/><path d=\"M6 12V4m12 8V4M7 16h1m4 0h1m4 0h1\"/></svg>",
        "devices" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"6\" y=\"2\" width=\"12\" height=\"20\" rx=\"3\"/><path d=\"M10 18h4\"/></svg>",
        "pause" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 4v16m8-16v16\"/></svg>",
        "tv" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"13\" rx=\"2\"/><path d=\"M8 21h8m-4-4v4\"/></svg>",
        "laptop" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"13\" rx=\"2\"/><path d=\"M2 20h20l-2-4H4Z\"/></svg>",
        "server" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"7\" rx=\"2\"/><rect x=\"4\" y=\"14\" width=\"16\" height=\"7\" rx=\"2\"/><path d=\"M8 6h.1M8 17h.1m5-11h4m-4 11h4\"/></svg>",
        "game" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 7h10c3 0 5 11 3 12s-5-4-6-4h-4c-1 0-4 5-6 4S4 7 7 7Z\"/><path d=\"M8 9v5m-2-2h4m6-2h.1m2 3h.1\"/></svg>",
        "camera" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 7h12v11H3Zm12 4 6-3v10l-6-3M7 7l2-3h4\"/></svg>",
        _ => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>"
    };

    private string IconFor(DeviceListRow row) => row.Device.LocalIconKey ?? row.Device.CategoryKey switch
    {
        "television" or "tv" => "tv",
        "computer" or "laptop" or "desktop" => "laptop",
        "server" or "nas" => "server",
        "game_console" or "gaming" => "game",
        "ip_camera" or "camera" => "camera",
        _ => "devices"
    };

    /// <summary>Prototype restriction chip: throttle, block, protection, or no restriction.</summary>
    private static MarkupString RestrictionChip(DeviceListRow row)
    {
        var kbps = row.Device.QuotaThrottle?.DownloadKbps;
        if (row.IsBlocked) return new MarkupString("<span class=\"chip blocked\">Blocked · recorded</span>");
        if (row.IsThrottled)
            return new MarkupString($"<span class=\"chip throttled\">{(kbps is { } value ? $"{value} Kbps · quota" : "Throttled")}</span>");
        if (row.IsProtected) return new MarkupString("<span class=\"chip ok\">Protected</span>");
        return new MarkupString("<span class=\"chip\">No restriction</span>");
    }
}
