@page "/settings/safety"
@page "/settings/safety/graduate"
@layout AppShell
@using NetPilot.Core.Safety
@using NetPilot.Core.Quota
@using NetPilot.Core.Devices
@using NetPilot.Core.Health
@using NetPilot.Core.Rules
@using NetPilot.Core.Usage
@inject ISafetyStore Store
@inject SafetyGraduationService Graduation
@inject IProtectedDeviceStore Protection
@inject IDeviceStore Devices
@inject IAgentHeartbeatStore Heartbeats
@inject RulesOptions Rules
@inject UsagePeriodClock Clock
@inject Confirm Confirm
<PageTitle>Safety Center · NetPilot</PageTitle>
<div class="page-head">
    <div>
        <div class="eyebrow">Observe first</div>
        <h1>Safety Center</h1>
        <p>Dry-run evaluates and logs what would happen. It can still notify, but does not create automatic router restrictions.</p>
    </div>
    <div class="actions">
        <a href="/settings" class="text-button">All settings</a>
        <button class="outline" @onclick="@(() => RunAsync(LoadAsync))" disabled="@_busy">@((MarkupString)Icon("refresh")) Reload / Retry</button>
    </div>
</div>

<div class="banner info">
    <span class="icon">@((MarkupString)Icon("shield"))</span>
    <div>
        <p>Keep enforcement dry-run until Internet counters and T8 are verified on your network. Manual controls and category speed policies operate separately. This UI never changes forced-dry-run deployment configuration.</p>
        <span class="chip dry">@(Rules.ForceDryRun ? "Rules: Forced dry-run" : "Rules: per-policy")</span>
    </div>
</div>

@if (_message is not null)
{
    <div class="banner @(_failed ? "error" : "info")" role="status">
        <span class="icon">@((MarkupString)Icon(_failed ? "warning" : "check"))</span>
        <p>@_message</p>
    </div>
}

<div class="grid">
    <section class="card span-6 tablet-full">
        <div class="section-head"><h2>Effective modes</h2></div>
        <div class="row between">
            <div>
                <div class="metric">Agent: @AgentHealth.Evaluate(_heartbeat, Clock.GetUtcNow())</div>
                <p class="hint">@(_heartbeat is null ? "Runtime mode unknown" : $"Reported rules {(_heartbeat.EffectiveModes.RulesForceDryRun ? "forced dry-run" : "per-policy")}; {(_heartbeat.EffectiveModes.RulesEnabled ? "enabled" : "disabled")}")</p>
            </div>
            <span class="chip @(Rules.ForceDryRun ? "dry" : "live")">@(Rules.ForceDryRun ? "Forced dry-run" : "Per-policy dry-run")</span>
        </div>
        <p>Web rules: @(Rules.ForceDryRun ? "Forced dry-run" : "Per-policy dry-run") · Kill switch: @(Rules.Enabled ? "Enabled" : "Disabled")</p>
        <p class="hint">Quotas use each saved policy’s DryRun flag; rules forced mode does not force quota dry-run. Saved enforcing policies: @_policies.Count(p => !p.DryRun) of @_policies.Count.</p>
        <p class="hint">Rules configuration: NETPILOT_RULES_FORCE_DRYRUN. Change only through a reviewed deployment after live checks, then wait for the Agent heartbeat. There is no configuration switch here.</p>
    </section>

    <section class="card span-6 tablet-full">
        <div class="section-head"><h2>Protected devices</h2></div>
        <p>Protection skips automatic device throttle/block. It does not prevent manual blocks or network-wide wireless changes.</p>
        @if (_protected.Count == 0)
        {
            <p class="hint">No protected devices recorded. Protect your management phone/server from device detail.</p>
        }
        @foreach (var device in _protected)
        {
            <div class="list-row">
                <div class="grow">
                    <h3>@device.Name</h3>
                    <p>@device.Mac · management device</p>
                </div>
                <a href="@($"/devices/{device.Mac}")" class="text-button">@((MarkupString)Icon("arrow"))</a>
            </div>
        }
        <a href="/devices" class="text-button">@((MarkupString)Icon("arrow")) Review devices and protection</a>
    </section>
</div>

<section class="card" style="margin-block-start:20px">
    <div class="section-head"><h2>Before you graduate</h2><small>Evidence checklist · administrator attestations</small></div>
    <p class="hint" style="margin-block-start:0">These are administrator attestations, not automatic verification. Record dates, measurements and method; include no passwords or tokens. Recheck after topology, firmware or policy changes.</p>
    @foreach (var requirement in Requirements)
    {
        var saved = _evidence.FirstOrDefault(e => e.Id == requirement.Id);
        <label class="check-row">
            <input type="checkbox" checked="@(saved is not null)" disabled />
            <span>@requirement.Label<small>@(saved is null ? "Not attested" : $"Attested by {saved.Actor}, {Local(saved.AtUtc)}: {saved.Method}")</small></span>
        </label>
    }
    <div class="form-grid" style="margin-block-start:16px">
        <label class="field">Administrator name
            <input type="text" maxlength="80" value="@_actor" @onchange="e => _actor = e.Value?.ToString() ?? string.Empty" />
        </label>
        <label class="field">Evidence item
            <select @bind="_evidenceId">
                @foreach (var requirement in Requirements)
                {
                    <option value="@requirement.Id">@requirement.Label</option>
                }
            </select>
        </label>
    </div>
    <label class="field" style="margin-block-start:16px">Measurement / method and result
        <textarea rows="3" maxlength="2000" value="@_method" @onchange="e => _method = e.Value?.ToString() ?? string.Empty"></textarea>
    </label>
    <div class="actions" style="margin-block-start:16px">
        <button class="button" @onclick="SaveEvidenceAsync" disabled="@_busy">Record administrator attestation</button>
    </div>
</section>

<section class="card" style="margin-block-start:20px">
    <div class="section-head"><h2>Review one policy</h2></div>
    @if (_policies.Count == 0)
    {
        <div class="empty-state">
            <span class="symbol-tile">@((MarkupString)Icon("shield"))</span>
            <h2>No policies</h2>
            <p>Create a quota or rule in dry-run before reviewing graduation.</p>
            <a href="/automations" class="button">Open automations</a>
        </div>
    }
    @foreach (var policy in _policies)
    {
        <div class="list-row" @key="(policy.Kind, policy.Id)">
            <div class="grow">
                <h3>@policy.Kind · @policy.Name</h3>
                <p>@policy.Action · @policy.Targets current targets · Saved mode: @(policy.DryRun ? "Dry-run" : "Enforcing configured")</p>
            </div>
            <button class="outline" @onclick="@(() => ReviewAsync(policy))" disabled="@(_busy || !policy.DryRun)">Review @policy.Name</button>
        </div>
    }
</section>

@if (_review is { } selected)
{
    <section class="card" style="margin-block-start:20px" role="region" aria-label="Policy graduation review">
        <div class="section-head"><h2>Graduate @selected.Name</h2></div>
        <p>@selected.Kind · @selected.Action · @selected.Targets current targets. Protected automatic device actions are skipped. Existing owners may still hold restrictions after release. Review windows and restores in @Clock.TimeZone.Id.</p>
        <p class="hint">Current target MACs: @(selected.TargetMacs.Length == 0 ? "None" : string.Join(", ", selected.TargetMacs))</p>
        @if (_blockReason is not null)
        {
            <div class="banner info">
                <span class="icon">@((MarkupString)Icon("warning"))</span>
                <p>@_blockReason</p>
            </div>
        }
        <h3>Release rehearsal</h3>
        <p>With physical router access, rehearse a single reversible throttle and release using existing controls. Check the router after the Agent tick and account for every other claim. Record the exact device, action, release and observed recovery. This form does not run a router command.</p>
        <a href="/devices" class="text-button">@((MarkupString)Icon("arrow")) Open device claims and Release controls</a>
        <label class="field" style="margin-block-start:16px">Release rehearsal method and observed recovery
            <textarea rows="3" maxlength="2000" value="@_rehearsal" @onchange="e => _rehearsal = e.Value?.ToString() ?? string.Empty"></textarea>
        </label>
        <div class="actions" style="margin-block-start:16px">
            <button class="button" @onclick="SaveRehearsalAsync" disabled="@_busy">Record release rehearsal for this policy version</button>
        </div>
        <p class="hint">Rehearsal: @(_evidence.Any(e => e.Id == selected.RehearsalId) ? "Administrator attestation recorded" : "Not recorded")</p>
        <label class="check-row">
            <input type="checkbox" checked="@_confirmed" @onchange="e => _confirmed = e.Value is true" />
            <span>I reviewed this one policy, its targets, evidence, timing and release rehearsal.</span>
        </label>
        <div class="actions">
            <button class="danger" @onclick="GraduateAsync" disabled="@(_busy || !_confirmed || _blockReason is not null)">Confirm per-policy enforcement review</button>
            <button class="text-button" @onclick="@(() => _review = null)" disabled="@_busy">Cancel review</button>
        </div>
    </section>
}

<section class="card" style="margin-block-start:20px">
    <div class="section-head"><h2>Graduation history</h2></div>
    <p class="hint" style="margin-block-start:0">Records capture the reviewed version and attestations. They do not prove router application or verify later edits.</p>
    @if (_history.Count == 0)
    {
        <p class="hint">No graduation records.</p>
    }
    @foreach (var record in _history.Take(50))
    {
        <p>@Local(record.AtUtc) · @record.Actor · @record.Policy.Kind @record.Policy.Name · @record.Policy.Action · @record.Policy.Targets targets · @record.Evidence.Length evidence items</p>
    }
</section>

@code {
    private static readonly (string Id, string Label)[] Requirements =
    [ ("counters", "Internet units, resets and several days of measurements"), ("lan-exclusion", "T8 TV/Jellyfin and YouTube counter experiment"),
      ("coverage", "Exporter coverage and router-byte fallback reviewed"), ("protection", "Management devices protected"),
      ("windows", "Cairo windows, actions and restore behavior reviewed"), ("phone", "Android notification display and delivery checked") ];
    private IReadOnlyList<PolicyReview> _policies = [];
    private IReadOnlyList<SafetyEvidence> _evidence = [];
    private IReadOnlyList<GraduationRecord> _history = [];
    private List<(string Mac, string Name)> _protected = [];
    private AgentHeartbeat? _heartbeat;
    private PolicyReview? _review;
    private string _actor = "", _method = "", _evidenceId = "counters", _rehearsal = "";
    private string? _message, _blockReason;
    private bool _busy, _failed, _confirmed;
    protected override Task OnInitializedAsync() => RunAsync(LoadAsync);
    private async Task LoadAsync()
    {
        _policies = await Graduation.GetPoliciesAsync(CancellationToken.None);
        _evidence = await Store.GetEvidenceAsync(CancellationToken.None); _history = await Store.GetGraduationsAsync(CancellationToken.None);
        _heartbeat = await Heartbeats.GetAsync(CancellationToken.None);
        var devices = await Devices.GetAllAsync(CancellationToken.None);
        _protected = (await Protection.GetAllAsync(CancellationToken.None)).Select(mac => (mac.ToString(), devices.FirstOrDefault(d => d.Mac == mac) is { } device ? DeviceList.DisplayName(device) : "Saved protected device")).ToList();
        if (_review is not null) _blockReason = await Graduation.BlockReasonAsync(_review.Kind, CancellationToken.None);
    }
    private async Task ReviewAsync(PolicyReview policy)
    { _review = policy; _confirmed = false; _rehearsal = ""; _blockReason = await Graduation.BlockReasonAsync(policy.Kind, CancellationToken.None); }
    private Task SaveEvidenceAsync() => RecordAsync(_evidenceId, _method);
    private Task SaveRehearsalAsync() => _review is null ? Task.CompletedTask : RecordAsync(_review.RehearsalId, _rehearsal);
    private Task RecordAsync(string id, string method) => RunAsync(async () =>
    {
        await Store.SaveEvidenceAsync(new(id, _actor.Trim(), method.Trim(), Clock.GetUtcNow()), CancellationToken.None);
        _message = "Administrator attestation saved; no automatic verification is claimed.";
        await LoadAsync();
    });
    private async Task GraduateAsync()
    {
        if (_busy || _review is not { } policy) return;
        if (!await Confirm.DangerAsync($"Enable enforcement for {policy.Name}?", $"Only this {policy.Kind} policy: {policy.Action}, {policy.Targets} current targets. Takes effect on the Agent’s next tick; other claims may still restrict devices. Forced configuration is unchanged.", "Enable this policy")) return;
        await RunAsync(async () =>
        {
            var error = await Graduation.GraduateAsync(policy, _actor, _confirmed, CancellationToken.None);
            _failed = error is not null; _message = error ?? "One policy saved for enforcement. Pending Agent next tick; no individual router application is confirmed.";
            if (error is null) _review = null;
            await LoadAsync();
        });
    }
    private async Task RunAsync(Func<Task> operation)
    {
        if (_busy) return;
        _busy = true; _failed = false; _message = null;
        try { await operation(); }
        catch (ArgumentException ex) { _failed = true; _message = ex.Message; }
        catch (Exception) { _failed = true; _message = "Safety operation failed. Reload and review before retrying."; }
        finally { _busy = false; }
    }
    private string Local(DateTimeOffset at) => TimeZoneInfo.ConvertTime(at, Clock.TimeZone).ToString("g");
    private string Icon(string name) => name switch
    {
        "shield" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 2 8 4v6c0 5-8 10-8 10S4 17 4 12V6Z\"/><path d=\"m8 12 3 3 5-6\"/></svg>",
        "refresh" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 7v5h-5M4 17v-5h5M5 7a8 8 0 0 1 14-1M5 18a8 8 0 0 0 14-1\"/></svg>",
        "arrow" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg>",
        "check" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12 4 4L20 5\"/></svg>",
        "warning" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 3 10 18H2Z\"/><path d=\"M12 9v5m0 3h.1\"/></svg>",
        _ => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>"
    };
}
