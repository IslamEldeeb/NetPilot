@page "/"
@layout AppShell
@inject IConfiguration Configuration
@if (!Configuration.GetValue("NetPilot:Ui:RedesignEnabled", true))
{
    <LegacyHome />
}
else
{
    <PageTitle>Home · NetPilot</PageTitle>
    <MudStack Spacing="2" Class="mb-6"><MudText Typo="Typo.overline" Color="Color.Primary">A calmer home network</MudText><MudText Typo="Typo.h1" HtmlTag="h1">Welcome to the new NetPilot</MudText><p>The new navigation is ready. Your network controls remain available throughout the redesign.</p></MudStack>
    <MudStack Spacing="5">
        <EmptyState Title="Your network, one step at a time" Body="Use Classic view for every existing feature while the new screens take shape." Href="/legacy" ActionText="Open classic view" />
        <MudPaper Elevation="0" Class="pa-6 mud-background"><MudText Typo="Typo.h2">Coming in the next steps</MudText><ul><li><MudLink Href="/devices">Devices</MudLink> · device list, details and restrictions</li><li><MudLink Href="/usage">Usage</MudLink> · Internet and LAN reporting</li><li><MudLink Href="/automations">Automations</MudLink> · quotas, rules and speed policies</li><li><MudLink Href="/activity">Activity</MudLink> · network events and history</li><li><MudLink Href="/settings">Settings</MudLink> · router, notifications and safety</li></ul></MudPaper>
    </MudStack>
}
