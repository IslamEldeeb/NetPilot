@page "/"
@layout AppShell
@inject IConfiguration Configuration
@if (!Configuration.GetValue("NetPilot:Ui:RedesignEnabled", true))
{
    <LegacyHome />
}
else
{
    <PageTitle>Home · NetPilot</PageTitle>
    <div class="np-page-head"><div class="np-eyebrow">A calmer home network</div><h1>Welcome to the new NetPilot</h1><p>The new navigation is ready. Your network controls remain available throughout the redesign.</p></div>
    <div class="np-stack">
        <EmptyState Title="Your network, one step at a time" Body="Use Classic view for every existing feature while the new screens take shape." Href="/legacy" ActionText="Open classic view" />
        <Card Toned="true"><h2>Coming in the next steps</h2><ul class="np-roadmap"><li><a href="/devices">Devices</a> · device list, details and restrictions</li><li><a href="/usage">Usage</a> · Internet and LAN reporting</li><li><a href="/automations">Automations</a> · quotas, rules and speed policies</li><li><a href="/activity">Activity</a> · network events and history</li><li><a href="/settings">Settings</a> · router, notifications and safety</li></ul></Card>
    </div>
}
