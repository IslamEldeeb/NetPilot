@page "/usage"
@layout AppShell
@using Microsoft.AspNetCore.Components.Forms
@using NetPilot.Core.Budget
@using NetPilot.Core.Usage
@using NetPilot.Web.Features
@using NetPilot.Web.Components.Usage
@using NetPilot.Web.Components.Devices
@inject UsageOverviewQuery Query
@inject IHouseholdBudgetStore Budgets
@inject UsagePeriodClock Clock
@inject ILogger<Usage> Logger
<PageTitle>Usage · NetPilot</PageTitle>
<div class="page-head np-usage-head">
    <div>
        <h1>Usage</h1>
        @if (_report is { } rangeReport)
        {
            <p>@rangeReport.Range.Start.ToString("dd MMM yyyy")@(_period == ReportPeriod.Day ? "" : $" – {rangeReport.Range.EndExclusive.AddDays(-1):dd MMM yyyy}") · @Clock.TimeZone.Id</p>
        }
    </div>
    <div class="actions">
        <div class="np-period-switch" role="group" aria-label="Usage period">
            @foreach (var period in new[] { ReportPeriod.Day, ReportPeriod.Week, ReportPeriod.Month })
            {
                <button type="button" aria-pressed="@(_period == period ? "true" : "false")" @onclick="() => ChangePeriod(period)">@(period == ReportPeriod.Month ? "Month" : period.ToString())</button>
            }
        </div>
        <button class="outline" @onclick="LoadAsync">@((MarkupString)Icon("refresh")) Refresh</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="banner error" role="alert">@((MarkupString)Icon("warning")) @_error <button class="text-button" @onclick="LoadAsync">Retry</button></div>
}
else if (_overview is null || _report is null)
{
    <div class="skeleton" aria-busy="true"></div>
    <div class="skeleton line"></div>
}
else
{
    var ov = _overview;
    var r = _report;
    <div class="np-usage-toolbar">
        <label class="field">Device
            <select value="@_mac" @onchange="e => ChangeDevice(e.Value?.ToString() ?? string.Empty)">
                <option value="">All devices</option>
                @foreach (var choice in DeviceChoices) { <option value="@choice.Mac">@choice.Name</option> }
            </select>
        </label>
        <p class="hint" id="usage-confidence">@ov.Confidence Historical bytes are not reclassified. LAN totals count both endpoints.</p>
    </div>
    <p class="hint">Last successful router read: @LocalTime(ov.Heartbeat?.LastSuccessfulRouterReadUtc). LAN source last read: @LocalTime(ov.LanStatus.LastReadAtUtc).</p>
    <div class="grid np-usage-grid">
        <section class="card span-4 np-usage-stat">
            <div class="eyebrow">Internet</div>
            @if (r.HasObservation) { <div class="np-usage-number">@DataSize.ToGb(r.InternetBytes).ToString("0.##") <small>GB</small></div> }
            else { <div class="np-usage-number">— <small>GB</small></div> }
            <p class="hint">Recorded Internet usage</p>
        </section>
        <section class="card span-4 np-usage-stat">
            <div class="eyebrow">Inside your home</div>
            @if (r.HasObservation && (r.LanBytes > 0 || (ov.LanStatus.IsConfigured && ov.LanStatus.LastReadAtUtc is not null))) { <div class="np-usage-number np-usage-lan">@DataSize.ToGb(r.LanBytes).ToString("0.##") <small>GB</small></div> }
            else { <div class="np-usage-number">— <small>GB</small></div> }
            <p class="hint">LAN traffic excluded where measured</p>
        </section>
        <section class="card span-4 np-usage-budget" id="household-budget">
            <div class="section-head"><h2>Household ISP budget</h2></div>
            <BudgetCard Overview="@ov" TimeZone="@Clock.TimeZone.Id" />
            <button class="outline" @onclick="OpenBudget">@((MarkupString)Icon("tune")) Edit ISP budget</button>
        </section>

        @if (r.HasObservation)
        {
            <section class="card span-12 np-usage-chart-card">
                <DeviceUsageChart Days="_days" />
                <p class="hint">1 GB = 1,000,000,000 bytes. Historical periods may contain unclassified LAN traffic; hourly detail is not available.</p>
            </section>
            <section class="card span-6">
                <div class="section-head"><h2>By category</h2></div>
                @foreach (var category in r.Rows.GroupBy(row => row.Category).OrderByDescending(group => group.Sum(row => row.InternetBytes)))
                {
                    var catBytes = category.Sum(row => row.InternetBytes);
                    var maxBytes = r.Rows.GroupBy(row => row.Category).Max(group => group.Sum(row => row.InternetBytes));
                    <div class="np-usage-row">
                        <div class="np-usage-row-main"><strong>@category.Key.Replace('_', ' ')</strong><div class="np-device-meter"><span style="width:@Percent(catBytes, maxBytes)%"></span></div></div>
                        <strong>@DataSize.ToGb(catBytes).ToString("0.##") GB</strong>
                    </div>
                }
            </section>
            <section class="card span-6">
                <div class="section-head"><h2>By device</h2><a class="outline" href="@CsvHref" download="netpilot-usage.csv">@((MarkupString)Icon("download")) CSV</a></div>
                @foreach (var device in r.Rows)
                {
                    <div class="np-usage-row">
                        <span class="symbol-tile">@((MarkupString)Icon("devices"))</span>
                        <div class="np-usage-row-main"><a href="@($"/devices/{device.Mac}")"><strong>@device.Name</strong></a><small>@device.Category.Replace('_', ' ')</small></div>
                        <strong>@DataSize.ToGb(device.InternetBytes).ToString("0.##") GB</strong>
                    </div>
                }
            </section>
        }
        else
        {
            <section class="card span-12 empty-state">
                <span class="symbol-tile">@((MarkupString)Icon("wifi"))</span>
                <h2>No saved usage for this period</h2>
                <p>Usage appears after the next successful tick. Missing observations are not zero.</p>
                <a href="/devices" class="button">See devices</a>
            </section>
        }
    </div>
}

<AppSheet @bind-Open="_editingBudget" Title="Household ISP budget">
    <MudStack Spacing="3">
        <MudText>This monthly household budget is separate from per-device quota caps. Saving it never changes
            enforcement.
        </MudText>
        <MudNumericField T="decimal?" @bind-Value="_budgetGb" Label="Monthly budget (decimal GB)" Min="0.000000001m"/>
        <MudNumericField T="int" @bind-Value="_billingDay" Label="Billing day (1–31)" Min="1" Max="31"
                         HelperText="Clamped independently to each month's last day."/>
        @if (_budgetError is not null)
        {
            <MudAlert Severity="Severity.Error">@_budgetError</MudAlert>
        }
        <MudButton OnClick="SaveBudgetAsync" Disabled="_savingBudget" Variant="Variant.Filled" Color="Color.Primary">
            Save budget
        </MudButton>
        <MudButton OnClick="RemoveBudgetAsync" Disabled="_savingBudget">Remove household budget</MudButton>
    </MudStack>
</AppSheet>

@code {

    private string Icon(string name) => name switch
    {
        "refresh" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 7v5h-5M4 17v-5h5M5 7a8 8 0 0 1 14-1M5 18a8 8 0 0 0 14-1\"/></svg>",
        "download" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5\"/></svg>",
        "arrow" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg>",
        "tune" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 6h18M3 12h18M3 18h18M7 3v6m10 0v6M9 15v6\"/></svg>",
        "leaf" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2L2 7l10 10 10-10L12 2Z\"/><path d=\"M2 17l10 -10 10 10\"/></svg>",
        "devices" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"6\" y=\"2\" width=\"12\" height=\"20\" rx=\"3\"/><path d=\"M10 18h4\"/></svg>",
        "wifi" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 8a16 16 0 0 1 20 0M5 12a11 11 0 0 1 14 0m-11 4a6 6 0 0 1 8 0\"/><circle cx=\"12\" cy=\"20\" r=\"1\"/></svg>",
        _ => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>"
    };

}
