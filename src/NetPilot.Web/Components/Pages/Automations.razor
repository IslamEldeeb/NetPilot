@page "/automations"
@page "/automations/{Section}"
@page "/automations/quotas/{QuotaScopeKey}"
@page "/automations/quotas/{QuotaScopeKey}/{Target}"
@page "/automations/rules/{RuleId:guid}/edit"
@page "/automations/rules/{RuleId:guid}/history"
@page "/automations/rules/new"
@page "/automations/rules/templates"
@layout AppShell
@using NetPilot.Web.Components.Automations
@inject NavigationManager Navigation
<PageTitle>Automations · NetPilot</PageTitle>
<MudStack Spacing="4">
    <MudText Typo="Typo.h1" HtmlTag="h1">Automations</MudText>
    <MudText>Choose a quota, rule or schedule. Saves await the Agent; dry-run observes and notifies.</MudText>
    <MudStack Row Wrap="Wrap.Wrap" Spacing="1" role="navigation" aria-label="Automation sections">
        @foreach (var destination in Sections)
        {
            <MudButton Href="@($"/automations/{destination.Key}")" Variant="@(Active == destination.Key ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" aria-current="@(Active == destination.Key ? "page" : null)">@destination.Label</MudButton>
        }
    </MudStack>
    @if (Active == "quotas") { <QuotaPanel @key="Navigation.Uri" ScopeKey="QuotaScopeKey" Target="Target" /> }
    else if (Active is "rules" or "schedules") { <RulesPanel @key="Navigation.Uri" Schedules="@(Active == "schedules")" RuleId="RuleId" /> }
    else if (Active == "policies") { <SpeedPolicies /> }
    else { <MudAlert Severity="Severity.Warning">Unknown automation section. Choose a section above.</MudAlert> }
    <MudLink Href="/legacy#policies" Target="_top">Classic automation controls</MudLink>
</MudStack>
@code {
    [Parameter] public string? Section { get; set; }
    [Parameter] public string? QuotaScopeKey { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public Guid? RuleId { get; set; }
    private static readonly (string Key, string Label)[] Sections = [("quotas", "Quotas"), ("rules", "Rules"), ("schedules", "Schedules"), ("policies", "Speed policies")];
    private string Active => new Uri(Navigation.Uri).AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries).ElementAtOrDefault(1) ?? "quotas";
}
