@page "/settings"
@page "/settings/{Section}"
@page "/settings/wireless/{NetworkId}"
@layout AppShell
@using NetPilot.Web.Components.Settings
@inject DashboardLoginOptions Login
<PageTitle>Settings · NetPilot</PageTitle>
<div class="page-head">
    <div>
        <div class="eyebrow">Your preferences</div>
        <h1>Settings</h1>
        <p>A dependable home network starts with clear controls.</p>
    </div>
    <div class="actions">
        <a href="/setup" class="text-button">Setup</a>
    </div>
</div>

<div class="settings-layout">
    <nav class="settings-nav" aria-label="Settings sections">
        @foreach (var entry in Entries)
        {
            var href = entry.Href;
            <a href="@href" class="@(IsActive(href) ? "active" : "")">@((MarkupString)Icon(entry.Icon)) @entry.Title</a>
        }
    </nav>
    <div>
        @if (Section is null && NetworkId is null)
        {
            <section class="card">
                <div class="section-head"><h2>Your household controls</h2></div>
                <p>Connect and maintain your network, keep alerts useful, and make safety visible.</p>
                @foreach (var entry in Entries)
                {
                    <a class="list-row" style="text-decoration:none;color:inherit" href="@entry.Href">
                        <span class="symbol-tile">@((MarkupString)Icon(entry.Icon))</span>
                        <span class="grow">
                            <strong>@entry.Title</strong>
                            <small>@entry.Body</small>
                        </span>
                        <span class="icon">@((MarkupString)Icon("arrow"))</span>
                    </a>
                }
            </section>
            @if (Login.Enabled)
            {
                <section class="card" style="margin-block-start:20px">
                    <div class="section-head"><h2>Security</h2></div>
                    <p>Shared dashboard password. There are no individual accounts.</p>
                    <form method="post" action="/logout" data-enhance="false">
                        <AntiforgeryToken />
                        <button type="submit" class="outline">@((MarkupString)Icon("lock")) Sign out</button>
                    </form>
                </section>
            }
            else
            {
                <div class="banner info">
                    <span class="icon">@((MarkupString)Icon("lock"))</span>
                    <p>Dashboard login is off. Configure NETPILOT_WEB_PASSWORD in deployment to enable sign-out and password protection.</p>
                </div>
            }
        }
        else
        {
            @switch (Section?.ToLowerInvariant() ?? "wireless")
            {
                case "router": <RouterSettings /> break;
                case "wireless": <WirelessSettings NetworkId="@NetworkId" /> break;
                case "notifications": <NotificationSettings /> break;
                case "backup": <BackupSettings /> break;
                case "appearance": <AppearanceSettings /> break;
                case "health": case "traffic": case "app": case "about": <HealthSettings /> break;
                case "security":
                    <section class="card">
                        <div class="section-head"><h2>Dashboard access</h2></div>
                        <p>Shared password login: @(Login.Enabled ? "Enabled" : "Off"). Configure NETPILOT_WEB_PASSWORD in deployment. There are no individual accounts.</p>
                        @if (Login.Enabled)
                        {
                            <form method="post" action="/logout" data-enhance="false">
                                <AntiforgeryToken />
                                <button type="submit" class="outline">@((MarkupString)Icon("lock")) Sign out</button>
                            </form>
                        }
                    </section>
                    break;
                default:
                    <div class="card empty-state">
                        <span class="symbol-tile">@((MarkupString)Icon("settings"))</span>
                        <h2>Settings section not found</h2>
                        <p>Choose a section from Settings.</p>
                        <a href="/settings" class="button">All settings</a>
                    </div>
                    break;
            }
        }
    </div>
</div>

@code {
    [Parameter] public string? Section { get; set; }
    [Parameter] public string? NetworkId { get; set; }
    private static readonly (string Title, string Body, string Href, string Icon)[] Entries =
    [
        ("Router", "Host, transport, encrypted credentials and connection test.", "/settings/router", "router"),
        ("Wireless", "Guest and IoT controls, main network read-only.", "/settings/wireless", "wifi"),
        ("Notifications", "This browser, shared preferences and push tests.", "/settings/notifications", "bell"),
        ("Safety Center", "Evidence, protected devices and one-policy graduation.", "/settings/safety", "shield"),
        ("Security", "Shared dashboard password and sign-out.", "/settings/security", "lock"),
        ("LAN source", "LAN exclusion and counter confidence.", "/settings/traffic", "leaf"),
        ("HTTPS / Install", "Phone installation guidance.", "/settings/app", "devices"),
        ("System health", "Agent heartbeat, router freshness and reboot.", "/settings/health", "activity"),
        ("Backup", "Download database and keys, restore guide and retention.", "/settings/backup", "cloud"),
        ("About / appearance", "Versions, timezone, provider and theme.", "/settings/about", "tune")
    ];
    private bool IsActive(string href) => Section is not null && href.EndsWith("/" + Section, StringComparison.OrdinalIgnoreCase);

    private string Icon(string name) => name switch
    {
        "router" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"12\" width=\"18\" height=\"8\" rx=\"2\"/><path d=\"M6 12V4m12 8V4M7 16h1m4 0h1m4 0h1\"/></svg>",
        "wifi" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 8a16 16 0 0 1 20 0M5 12a11 11 0 0 1 14 0m-11 4a6 6 0 0 1 8 0\"/><circle cx=\"12\" cy=\"20\" r=\"1\"/></svg>",
        "bell" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 17h14l-2-4V8a5 5 0 0 0-10 0v5Zm5 3h4\"/></svg>",
        "shield" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 2 8 4v6c0 5-8 10-8 10S4 17 4 12V6Z\"/><path d=\"m8 12 3 3 5-6\"/></svg>",
        "lock" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"5\" y=\"10\" width=\"14\" height=\"11\" rx=\"2\"/><path d=\"M8 10V6a4 4 0 0 1 8 0v4\"/></svg>",
        "leaf" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 3C6 2 1 10 6 17s16 0 14-14ZM5 20 16 8\"/></svg>",
        "devices" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"6\" y=\"2\" width=\"12\" height=\"20\" rx=\"3\"/><path d=\"M10 18h4\"/></svg>",
        "activity" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 5h2m4 0h10M4 12h2m4 0h10M4 19h2m4 0h10\"/></svg>",
        "cloud" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 18a5 5 0 0 1-1-10 7 7 0 0 1 13-1 5 5 0 0 1 1 11Z\"/></svg>",
        "tune" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 6h18M3 12h18M3 18h18M7 3v6m10 0v6M9 15v6\"/></svg>",
        "settings" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m9 3-1 3-3 1 1 4-2 2 2 3 3-1 2 3h3l1-3 3-1 1-3-2-2 1-3-3-1-1-3Z\"/><circle cx=\"12\" cy=\"11\" r=\"3\"/></svg>",
        "arrow" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg>",
        _ => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>"
    };
}
