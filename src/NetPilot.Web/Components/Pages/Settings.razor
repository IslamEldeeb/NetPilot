@page "/settings"
@page "/settings/{Section}"
@page "/settings/wireless/{NetworkId}"
@layout AppShell
@using NetPilot.Web.Components.Settings
@inject DashboardLoginOptions Login
<PageTitle>Settings · NetPilot</PageTitle>
<div class="page-head">
    <div><div class="eyebrow">Your network</div><h1>Settings</h1><p>Manage your connection, notifications and preferences.</p></div>
</div>
<div class="settings-layout">
    <nav class="settings-nav" aria-label="Settings sections">
        @foreach (var entry in Entries)
        {
            <a href="@entry.Href" class="@(IsActive(entry.Href) ? "active" : "")" aria-current="@(IsActive(entry.Href) ? "page" : null)">@((MarkupString)Icon(entry.Icon)) @entry.Title</a>
        }
        <div class="settings-nav-divider"></div>
        <span class="settings-nav-label">Network tools</span>
        <a href="/settings/safety">@((MarkupString)Icon("shield")) Safety center</a>
        <a href="/settings/health">@((MarkupString)Icon("activity")) System health</a>
    </nav>
    <main class="settings-content">
        @switch (Section?.ToLowerInvariant() ?? "general")
        {
            case "general": case "appearance": case "security":
                <div class="settings-heading"><h2>General</h2><p>Control refresh timing, appearance and dashboard access.</p></div>
                <PollingSettings />
                <section class="card settings-panel"><AppearanceSettings /></section>
                <section class="card settings-panel">
                    <h2>Dashboard access</h2>
                    <p>Shared password login: <strong>@(Login.Enabled ? "On" : "Off")</strong>.</p>
                    @if (Login.Enabled)
                    {
                        <form method="post" action="/logout" data-enhance="false"><AntiforgeryToken /><button type="submit" class="outline">Sign out</button></form>
                    }
                    else { <p class="hint">Set a dashboard password in your deployment to protect access.</p> }
                </section>
                break;
            case "router":
                <div class="settings-heading"><h2>Router</h2><p>Manage the connection to your router.</p></div>
                <section class="card settings-panel"><RouterSettings /></section>
                break;
            case "wireless":
                <div class="settings-heading"><h2>Wi-Fi</h2><p>View and manage supported wireless networks.</p></div>
                <section class="card settings-panel"><WirelessSettings NetworkId="@NetworkId" /></section>
                break;
            case "notifications":
                <div class="settings-heading"><h2>Notifications</h2><p>Choose what NetPilot sends and which devices receive alerts.</p></div>
                <section class="card settings-panel"><NotificationSettings /></section>
                break;
            case "backup":
                <div class="settings-heading"><h2>Backup</h2><p>Keep a copy of your NetPilot data.</p></div>
                <section class="card settings-panel"><BackupSettings /></section>
                break;
            case "health": case "traffic": case "app": case "about":
                <div class="settings-heading"><h2>System health</h2><p>Connection status and troubleshooting information.</p></div>
                <section class="card settings-panel"><HealthSettings /></section>
                break;
            default:
                <div class="card empty-state"><h2>Settings section not found</h2><a href="/settings" class="button">General settings</a></div>
                break;
        }
    </main>
</div>

@code {
    [Parameter] public string? Section { get; set; }
    [Parameter] public string? NetworkId { get; set; }
    private static readonly (string Title, string Href, string Icon)[] Entries =
    [
        ("General", "/settings", "tune"),
        ("Router", "/settings/router", "router"),
        ("Wi-Fi", "/settings/wireless", "wifi"),
        ("Notifications", "/settings/notifications", "bell"),
        ("Backup", "/settings/backup", "cloud")
    ];
    private bool IsActive(string href) => href == "/settings"
        ? Section is null || Section.Equals("general", StringComparison.OrdinalIgnoreCase) || Section.Equals("appearance", StringComparison.OrdinalIgnoreCase) || Section.Equals("security", StringComparison.OrdinalIgnoreCase)
        : Section is not null && href.EndsWith("/" + Section, StringComparison.OrdinalIgnoreCase);

    private string Icon(string name) => name switch
    {
        "router" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"12\" width=\"18\" height=\"8\" rx=\"2\"/><path d=\"M6 12V4m12 8V4M7 16h1m4 0h1m4 0h1\"/></svg>",
        "wifi" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 8a16 16 0 0 1 20 0M5 12a11 11 0 0 1 14 0m-11 4a6 6 0 0 1 8 0\"/><circle cx=\"12\" cy=\"20\" r=\"1\"/></svg>",
        "bell" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 17h14l-2-4V8a5 5 0 0 0-10 0v5Zm5 3h4\"/></svg>",
        "shield" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 2 8 4v6c0 5-8 10-8 10S4 17 4 12V6Z\"/><path d=\"m8 12 3 3 5-6\"/></svg>",
        "lock" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"5\" y=\"10\" width=\"14\" height=\"11\" rx=\"2\"/><path d=\"M8 10V6a4 4 0 0 1 8 0v4\"/></svg>",
        "leaf" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 3C6 2 1 10 6 17s16 0 14-14ZM5 20 16 8\"/></svg>",
        "devices" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"6\" y=\"2\" width=\"12\" height=\"20\" rx=\"3\"/><path d=\"M10 18h4\"/></svg>",
        "activity" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 5h2m4 0h10M4 12h2m4 0h10M4 19h2m4 0h10\"/></svg>",
        "cloud" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 18a5 5 0 0 1-1-10 7 7 0 0 1 13-1 5 5 0 0 1 1 11Z\"/></svg>",
        "tune" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 6h18M3 12h18M3 18h18M7 3v6m10 0v6M9 15v6\"/></svg>",
        "settings" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m9 3-1 3-3 1 1 4-2 2 2 3 3-1 2 3h3l1-3 3-1 1-3-2-2 1-3-3-1-1-3Z\"/><circle cx=\"12\" cy=\"11\" r=\"3\"/></svg>",
        "arrow" => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg>",
        _ => "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>"
    };
}
