@using NetPilot.Core.Usage
@using NetPilot.Web.Features
@* Content only: the page owns the card frame and the section title. *@
<div class="budget-card">
    @if (Overview.Budget is { } budget && Overview.Cycle is { } cycle)
    {
        <p class="hint" style="margin-block-start:0">@cycle.Start.ToString("yyyy-MM-dd") to @cycle.EndExclusive.AddDays(-1).ToString("yyyy-MM-dd") · @TimeZone</p>
        @if (Overview.CycleUsage is { HasObservation: true } usage)
        {
            <p>@DataSize.ToGb(usage.InternetBytes).ToString("0.##") of @DataSize.ToGb(budget.MonthlyBytes).ToString("0.##") GB Internet recorded</p>
            <p class="hint">Missing days are unobserved, not zero. Billing-cycle totals use available saved history.</p>
        }
        else
        {
            <p>Usage unknown · budget @DataSize.ToGb(budget.MonthlyBytes).ToString("0.##") GB</p>
        }
        @if (Overview.Forecast is { } estimate)
        {
            <p><strong>Estimated: about @decimal.Ceiling(estimate.DaysRemaining) days left, around @estimate.EstimatedExhaustion.ToString("yyyy-MM-dd").</strong></p>
            <p class="hint">@DataSize.ToGb(estimate.AverageBytesPerDay).ToString("0.##") GB/day from @estimate.SampleDays valid completed days in the last seven days.</p>
        }
        else
        {
            <p>Estimate unavailable: not enough reliable history, incomplete cycle coverage, or a stale read/outage.</p>
        }
        <p class="hint">Method: average Internet bytes across valid completed days in the last seven days (at least three). Divide remaining cycle budget by that daily average. Forecast is an estimate and never triggers enforcement.</p>
    }
    else
    {
        <p>No household budget configured. Device quotas are separate.</p>
    }
</div>
@code {
    [Parameter, EditorRequired] public UsageOverview Overview { get; set; } = default!;
    [Parameter] public string TimeZone { get; set; } = UsagePeriodClock.DefaultTimeZoneId;
}
