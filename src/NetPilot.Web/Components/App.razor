<!DOCTYPE html>
<html lang="en" data-netpilot-ui="@(UseMud ? "mud" : "legacy")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    @* Classic links reload the document so the Mud reset/utilities never enter its CSS cascade. *@
    @if (UseMud)
    {
        <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    }
    <link rel="stylesheet" href="@Assets["css/app-shell.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["NetPilot.Web.styles.css"]" />
    <ImportMap />
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#f6faf7" />
    <script src="@Assets["js/theme.js"]"></script>
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/app-shell.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@inject IConfiguration Configuration
@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    private bool UseMud => Configuration.GetValue("NetPilot:Ui:RedesignEnabled", true)
        && !HttpContext.Request.Path.StartsWithSegments("/legacy");
}
