@using NetPilot.Abstractions
@using NetPilot.Core.RouterConnection
@using NetPilot.Core.Actions
@using NetPilot.Core.Devices
@using NetPilot.Core.Enforcement.Claims
@using NetPilot.Core.Quota
@using NetPilot.Core.Usage
@inject IRouterProvider RouterProvider
@inject IRouterConnectionStore RouterConnections
@inject SettingsRouterActions RouterActions
@inject Confirm Confirm
@inject TemporaryActions Commands
@inject NetPilot.Core.Actions.TemporaryActionOptions ActionOptions
@inject QuotaBonusCommands Bonuses
@inject IDeviceStore Devices
@inject IProtectedDeviceStore Protection
@inject UsagePeriodClock Clock
@inject IConfiguration Configuration
@inject ILogger<QuickActionsSheet> Logger
<AppSheet Open="Open" OpenChanged="OpenChanged" Title="Quick action" BottomSheetOnMobile="true">
    <ChildContent>
    <div class="np-quick-sheet">
        <div class="np-quick-choices" role="group" aria-label="Action">
            <button type="button" class="np-quick-choice" aria-pressed="@(_action == "pause" ? "true" : "false")" disabled="@(_busy || _accepted)" @onclick="@(() => SelectAction("pause"))">
                <MudIcon Icon="@Icons.Material.Outlined.Pause" /><span>Pause</span>
            </button>
            <button type="button" class="np-quick-choice" aria-pressed="@(_action == "throttle" ? "true" : "false")" disabled="@(_busy || _accepted)" @onclick="@(() => SelectAction("throttle"))">
                <MudIcon Icon="@Icons.Material.Outlined.Speed" /><span>Slow down</span>
            </button>
            <button type="button" class="np-quick-choice" aria-pressed="@(_action == "bonus" ? "true" : "false")" disabled="@(_busy || _accepted)" @onclick="@(() => SelectAction("bonus"))">
                <MudIcon Icon="@Icons.Material.Outlined.CardGiftcard" /><span>Extra GB</span>
            </button>
            <button type="button" class="np-quick-choice" aria-pressed="@(_action == "reboot" ? "true" : "false")" disabled="@(_busy || _accepted)" @onclick="@(() => SelectAction("reboot"))">
                <MudIcon Icon="@Icons.Material.Outlined.RestartAlt" /><span>Reboot router</span>
            </button>
        </div>
        @if (_action == "reboot")
        {
            <MudAlert Severity="Severity.Warning">Rebooting disconnects all devices. The router reboot endpoint has not been verified on this model; recovery must be checked separately.</MudAlert>
            @if (!_routerConfigured) { <MudText>Configure a router before rebooting.</MudText> }
            else if (!RouterProvider.Capabilities.SupportsReboot) { <MudText>This router provider does not support reboot.</MudText> }
        }
        else
        {
        <MudSelect T="string" @bind-Value="_target" Label="Device or category" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var device in _devices) { <MudSelectItem T="string" Value="@($"device:{device.Mac}")">@HouseholdUsage.DeviceName(device)</MudSelectItem> }
            @if (_action != "bonus") { @foreach (var category in _devices.Select(device => device.CategoryKey).Distinct().Order()) { <MudSelectItem T="string" Value="@($"category:{category}")">Category: @category</MudSelectItem> } }
        </MudSelect>
        @if (_action == "bonus")
        {
            <MudSelect T="QuotaPeriodKind" @bind-Value="_period" Label="Named quota period" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="QuotaPeriodKind.Day">Day</MudSelectItem><MudSelectItem Value="QuotaPeriodKind.Month">Month</MudSelectItem></MudSelect>
            <MudNumericField T="decimal" @bind-Value="_bonusGb" Label="Bonus (decimal GB)" Min="0.000000001m" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudText Typo="Typo.body2">Grant @_bonusGb GB to @TargetName for @_period · @PeriodKey. Other quota periods, rules, manual blocks and base policies still apply. This is an allowance, not a timed exemption.</MudText>
        }
        else
        {
            <MudSelect T="int" @bind-Value="_minutes" Label="For how long" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="15">15 minutes</MudSelectItem><MudSelectItem Value="30">30 minutes</MudSelectItem><MudSelectItem Value="60">1 hour</MudSelectItem><MudSelectItem Value="0">Custom duration</MudSelectItem></MudSelect>
            @if (_minutes == 0) { <MudNumericField T="int" @bind-Value="_customMinutes" Label="Custom minutes (1–1440)" Min="1" Max="1440" Variant="Variant.Outlined" Margin="Margin.Dense" /> }
            @if (_action == "throttle") { <MudNumericField T="int" @bind-Value="_kbps" Label="Symmetric throttle (Kbps)" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" /> }
            <MudText Typo="Typo.body2">@TargetName · @Targets.Length selected · @Targets.Count(mac => _protected.Contains(mac)) protected targets skipped · @Duration minutes.</MudText>
            <MudAlert Severity="@(_dryRun ? Severity.Info : Severity.Warning)">
                @(_dryRun ? "Dry-run preview only; no router restriction." : _action == "pause" ? "The Agent will pause Internet through an expiring block claim." : $"The Agent will throttle to {_kbps} Kbps through an expiring claim.")
                Expiry is measured from save; release happens on the first successful tick after expiry. Other holds and base policies remain. Protected devices are checked again by the Agent.
            </MudAlert>
        }
        <MudText Typo="Typo.caption">Takes effect on the Agent’s next tick. Retries or an offline Agent can take longer. No router command is sent by this sheet.</MudText>
        }
        @if (_message is not null) { <MudAlert Severity="Severity.Success" role="status">@_message</MudAlert> }
        @if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert> }
    </div>
    </ChildContent>
    <Footer>
        <MudButton OnClick="@(() => OpenChanged.InvokeAsync(false))" Variant="Variant.Outlined">Cancel</MudButton>
        @if (_action == "reboot")
        { <MudButton OnClick="RebootAsync" Disabled="@(_busy || _accepted || !_routerConfigured || !RouterProvider.Capabilities.SupportsReboot)" Variant="Variant.Filled" Color="Color.Error">Reboot router</MudButton> }
        else
        { <MudButton OnClick="SaveAsync" Disabled="@(_busy || Targets.Length == 0 || _accepted)" Variant="Variant.Filled" Color="Color.Primary">Apply</MudButton> }
    </Footer>
</AppSheet>
@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string? DeviceMac { get; set; }
    [Parameter] public EventCallback Saved { get; set; }
    private IReadOnlyList<Device> _devices = [];
    private IReadOnlyList<MacAddress> _protected = [];
    private string _action = "pause", _target = "";
    private string? _error, _message;
    private int _minutes = 60, _customMinutes = 45, _kbps = 512;
    private decimal _bonusGb = 1;
    private QuotaPeriodKind _period;
    private bool _dryRun = true, _busy, _wasOpen, _accepted, _routerConfigured;
    private Guid _requestId;
    private string _dayKey = "", _monthKey = "";
    private int Duration => _minutes == 0 ? _customMinutes : _minutes;
    private string PeriodKey => _period == QuotaPeriodKind.Day ? _dayKey : _monthKey;
    private MacAddress[] Targets => _devices.Where(device => _target == $"device:{device.Mac}" || (_action != "bonus" && _target == $"category:{device.CategoryKey}")).Select(device => device.Mac).ToArray();
    private string TargetName => _target.StartsWith("category:", StringComparison.Ordinal) ? _target[9..]
        : _devices.FirstOrDefault(device => _target == $"device:{device.Mac}") is { } device ? HouseholdUsage.DeviceName(device) : "Choose a device";
    protected override async Task OnParametersSetAsync()
    {
        if (Open && !_wasOpen)
        {
            _error = _message = null;
            _accepted = false;
            _requestId = Guid.NewGuid();
            _dryRun = ActionOptions.ForceDryRun;
            _dayKey = Clock.TodayKey(); _monthKey = Clock.ThisMonthKey();
            try
            {
                _routerConfigured = await RouterConnections.GetAsync(CancellationToken.None) is not null;
                _devices = await Devices.GetAllAsync(CancellationToken.None);
                _protected = await Protection.GetAllAsync(CancellationToken.None);
                _target = DeviceMac is not null ? $"device:{DeviceMac}" : _devices.FirstOrDefault() is { } first ? $"device:{first.Mac}" : "";
            }
            catch (Exception ex) { Logger.LogWarning(ex, "Cannot load action targets"); _error = "Could not load targets. Close and retry."; _devices = []; }
        }
        _wasOpen = Open;
    }
    private void SelectAction(string action)
    {
        _action = action;
        if (action == "bonus" && _target.StartsWith("category:", StringComparison.Ordinal))
            _target = _devices.FirstOrDefault() is { } first ? $"device:{first.Mac}" : "";
    }
    private async Task RebootAsync()
    {
        if (_busy || _accepted || !_routerConfigured || !RouterProvider.Capabilities.SupportsReboot) return;
        if (!await Confirm.DangerAsync("Reboot router?", "All devices will lose their connection temporarily. The reboot endpoint is not verified; have physical access and check recovery before retrying.", "Reboot now")) return;
        _busy = true; _error = _message = null;
        try
        {
            await RouterActions.RebootAsync();
            _accepted = true;
            _message = "Reboot command sent. Recovery is not verified; wait before checking the connection.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Router reboot failed");
            _accepted = true;
            _error = "Reboot request failed or its result is unknown. Check the router before retrying.";
        }
        finally { _busy = false; }
    }

    private async Task SaveAsync()
    {
        _busy = true; _error = _message = null;
        try
        {
            if (_action == "bonus")
            {
                if (Targets.Length != 1) throw new ArgumentException("Choose one device with a configured quota.");
                await Bonuses.GrantAsync(new(_requestId, Targets[0], _period, PeriodKey, DataSize.FromGb(_bonusGb)), CancellationToken.None);
                _message = $"Bonus saved for {_period} {PeriodKey}; the Agent evaluates it on its next tick. Other holds remain.";
            }
            else
            {
                var saved = await Commands.RequestAsync(new(_requestId, Targets, _action == "pause" ? ClaimKind.Block : ClaimKind.Throttle,
                    Duration, _action == "throttle" ? _kbps : null, _dryRun), CancellationToken.None);
                _message = $"Saved {saved.Accepted} request(s); skipped {saved.ProtectedSkipped} protected device(s). {(_dryRun ? "Dry-run preview only." : "Waiting for the Agent's next tick.")}";
            }
            _accepted = true;
            await Saved.InvokeAsync();
        }
        catch (ArgumentException ex) { _error = ex.Message; }
        catch (OverflowException) { _error = "The bonus exceeds the supported byte count."; }
        catch (Exception ex) { Logger.LogWarning(ex, "Cannot save quick action"); _error = "Could not complete the request. Retry safely; already saved requests are retained."; }
        finally { _busy = false; }
    }
}
