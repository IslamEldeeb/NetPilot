@inherits LayoutComponentBase
@using NetPilot.Core.Usage
@inject UsagePeriodClock Clock
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@if (!Configuration.GetValue("NetPilot:Ui:RedesignEnabled", true))
{
    <LayoutView Layout="typeof(MainLayout)">@Body</LayoutView>
}
else
{
    <div class="np-shell">
        <a class="np-skip" href="#main-content">Skip to content</a>
        <AdaptiveNav />
        <div class="np-workspace">
            <header class="np-app-bar">
                <span class="np-app-context">Home network <span>/ @ZoneName</span></span>
                <div class="np-app-tools">
                    <button type="button" class="np-icon-button" data-np-search title="Search (Ctrl/⌘ K)" aria-label="Search devices and pages" @onclick="() => _searchOpen = true"><Icon Name="search" /></button>
                    <ThemeToggle />
                    <a href="/settings" class="np-settings-link" aria-label="Settings" aria-current="@(ShellNavigation.Owner("/" + Navigation.ToBaseRelativePath(Navigation.Uri)) == ShellNavigation.Settings ? "page" : null)"><Icon Name="settings" /><span>Settings</span></a>
                </div>
            </header>
            <ModeStrip />
            <main id="main-content" class="np-main" tabindex="-1">@Body</main>
            <footer class="np-shell-footer"><a href="/legacy">Classic view</a><span>@Clock.TimeZone.Id · Web configuration shown in Safety Center</span></footer>
        </div>
        <GlobalSearch @bind-Open="_searchOpen" />
        <SnackbarHost />
    </div>
    <div id="blazor-error-ui" data-nosnippet>An unhandled error has occurred. <a href="." class="reload">Reload</a><button type="button" class="dismiss" aria-label="Dismiss error">×</button></div>
}
@code {
    private bool _searchOpen;
    private string ZoneName => Clock.TimeZone.Id.Split('/')[^1].Replace('_', ' ');
}
