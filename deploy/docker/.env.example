# Dashboard shared password. Empty disables login (local/private deployments only).
# REQUIRED for a public subdomain. Use a long random password, keep .env private.
# Passed only to Web as NetPilot__Web__Password. Never publish Web :8080 directly.
NETPILOT_WEB_PASSWORD=

# First-run router connection seed; subsequent changes use the dashboard.
ROUTER_HOST=192.168.1.1
ROUTER_PASSWORD=changeme

# Replace with a real monitored mailto: contact before enabling Web Push.
# Compose falls back to mailto:netpilot@localhost if unset/empty (placeholder only).
NETPILOT_VAPID_SUBJECT=mailto:you@example.com
# Optional IANA timezone shared by Agent and Web (usage days and quiet hours).
NETPILOT_TIMEZONE=Africa/Cairo

# First deployment: all rules only log/notify. Set false after Internet usage is verified.
# Per-rule DryRun still defaults to true; disabling this override does not enable rules individually.
NETPILOT_RULES_FORCE_DRYRUN=true
# Kill switch and tick interval shared by Agent/Web so the dashboard reflects deployment settings.
NETPILOT_RULES_ENABLED=true
NETPILOT_POLL_INTERVAL_SECONDS=180

# Optional Tailscale override: secret enrollment key, never commit the real value.
# Prefer a short-lived, tagged, one-off key; see docs/https-access.md.
TS_AUTHKEY=
TS_HOSTNAME=netpilot

# Optional LAN counter exporter; leave unset until bridge counters are verified.
# NETPILOT_LANTRAFFIC_URL=http://192.168.1.13:9918/flows
# NETPILOT_LANTRAFFIC_TOKEN=replace-with-a-random-token

# Web UI redesign foundation. false restores the classic dashboard at /.
# The complete existing dashboard is always reachable at /legacy.
NETPILOT_UI_REDESIGN=true

# Temporary pause/throttle previews only until live counters and recovery are verified.
NETPILOT_TEMPORARY_FORCE_DRYRUN=true
